{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🖼️ Image Classification with a CNN\n",
    "**Task:** Classify images into 10 categories using a convolutional neural network.\n",
    "\n",
    "**Dataset:** CIFAR-10 (60,000 32×32 colour images, 10 classes)\n",
    "\n",
    "**Techniques covered:**\n",
    "- Data loading, normalisation & augmentation\n",
    "- Custom CNN architecture (Conv → BatchNorm → Pool → Dropout)\n",
    "- Training loop with learning rate scheduling\n",
    "- Training/validation curves\n",
    "- Confusion matrix & per-class analysis\n",
    "- Visualising misclassified images\n",
    "- Transfer Learning section (MobileNetV2 backbone)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# TensorFlow / Keras\n",
    "import tensorflow as tf\n",
    "from tensorflow import keras\n",
    "from tensorflow.keras import layers, models, callbacks\n",
    "from tensorflow.keras.datasets import cifar10\n",
    "from tensorflow.keras.preprocessing.image import ImageDataGenerator\n",
    "from sklearn.metrics import classification_report, confusion_matrix, ConfusionMatrixDisplay\n",
    "\n",
    "print(f'TensorFlow version: {tf.__version__}')\n",
    "print(f'GPU available: {len(tf.config.list_physical_devices(\"GPU\")) > 0}')\n",
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "np.random.seed(42)\n",
    "tf.random.set_seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 1. Load & Explore CIFAR-10"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "(X_train, y_train), (X_test, y_test) = cifar10.load_data()\n",
    "y_train = y_train.flatten()\n",
    "y_test  = y_test.flatten()\n",
    "\n",
    "CLASS_NAMES = ['airplane','automobile','bird','cat','deer',\n",
    "               'dog','frog','horse','ship','truck']\n",
    "\n",
    "print(f'Train: {X_train.shape} | Test: {X_test.shape}')\n",
    "print(f'Pixel range: [{X_train.min()}, {X_train.max()}]')\n",
    "print(f'Classes: {CLASS_NAMES}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualise sample images from each class\n",
    "fig, axes = plt.subplots(2, 5, figsize=(14, 6))\n",
    "for cls_idx, ax in enumerate(axes.flat):\n",
    "    idx = np.where(y_train == cls_idx)[0][0]\n",
    "    ax.imshow(X_train[idx])\n",
    "    ax.set_title(CLASS_NAMES[cls_idx], fontsize=12, fontweight='bold')\n",
    "    ax.axis('off')\n",
    "plt.suptitle('CIFAR-10 — One Sample per Class', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Class distribution\n",
    "unique, counts = np.unique(y_train, return_counts=True)\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.bar([CLASS_NAMES[i] for i in unique], counts, color='steelblue', edgecolor='white')\n",
    "plt.title('Class Distribution (Training Set)', fontsize=13)\n",
    "plt.ylabel('Count')\n",
    "plt.xticks(rotation=20)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "print('Dataset is perfectly balanced — 5,000 images per class.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 2. Preprocessing & Data Augmentation"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Normalise to [0, 1]\n",
    "X_train_norm = X_train.astype('float32') / 255.0\n",
    "X_test_norm  = X_test.astype('float32')  / 255.0\n",
    "\n",
    "# Per-channel mean/std normalisation (ImageNet-style)\n",
    "mean = X_train_norm.mean(axis=(0,1,2), keepdims=True)\n",
    "std  = X_train_norm.std(axis=(0,1,2),  keepdims=True)\n",
    "X_train_norm = (X_train_norm - mean) / (std + 1e-7)\n",
    "X_test_norm  = (X_test_norm  - mean) / (std + 1e-7)\n",
    "\n",
    "# One-hot encode labels\n",
    "y_train_oh = keras.utils.to_categorical(y_train, 10)\n",
    "y_test_oh  = keras.utils.to_categorical(y_test,  10)\n",
    "\n",
    "# Data augmentation pipeline\n",
    "datagen = ImageDataGenerator(\n",
    "    horizontal_flip=True,\n",
    "    width_shift_range=0.1,\n",
    "    height_shift_range=0.1,\n",
    "    rotation_range=15,\n",
    "    zoom_range=0.1,\n",
    "    fill_mode='reflect'\n",
    ")\n",
    "datagen.fit(X_train_norm)\n",
    "\n",
    "print('Preprocessing complete.')\n",
    "print(f'Train range after norm: [{X_train_norm.min():.2f}, {X_train_norm.max():.2f}]')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualise augmented samples\n",
    "sample_img = X_train_norm[:1]\n",
    "aug_iter   = datagen.flow(sample_img, batch_size=1)\n",
    "\n",
    "fig, axes = plt.subplots(1, 6, figsize=(14, 3))\n",
    "axes[0].imshow(X_train[0])\n",
    "axes[0].set_title('Original')\n",
    "axes[0].axis('off')\n",
    "for i in range(1, 6):\n",
    "    aug = next(aug_iter)[0]\n",
    "    # De-normalise for display\n",
    "    disp = (aug * (std[0] + 1e-7) + mean[0]).clip(0, 1)\n",
    "    axes[i].imshow(disp)\n",
    "    axes[i].set_title(f'Aug {i}')\n",
    "    axes[i].axis('off')\n",
    "plt.suptitle('Data Augmentation Examples', fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 3. CNN Architecture"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_cnn(input_shape=(32, 32, 3), num_classes=10):\n",
    "    model = models.Sequential([\n",
    "        # Block 1\n",
    "        layers.Conv2D(32, (3,3), padding='same', activation='relu', input_shape=input_shape),\n",
    "        layers.BatchNormalization(),\n",
    "        layers.Conv2D(32, (3,3), padding='same', activation='relu'),\n",
    "        layers.BatchNormalization(),\n",
    "        layers.MaxPooling2D((2,2)),\n",
    "        layers.Dropout(0.25),\n",
    "\n",
    "        # Block 2\n",
    "        layers.Conv2D(64, (3,3), padding='same', activation='relu'),\n",
    "        layers.BatchNormalization(),\n",
    "        layers.Conv2D(64, (3,3), padding='same', activation='relu'),\n",
    "        layers.BatchNormalization(),\n",
    "        layers.MaxPooling2D((2,2)),\n",
    "        layers.Dropout(0.25),\n",
    "\n",
    "        # Block 3\n",
    "        layers.Conv2D(128, (3,3), padding='same', activation='relu'),\n",
    "        layers.BatchNormalization(),\n",
    "        layers.Conv2D(128, (3,3), padding='same', activation='relu'),\n",
    "        layers.BatchNormalization(),\n",
    "        layers.MaxPooling2D((2,2)),\n",
    "        layers.Dropout(0.4),\n",
    "\n",
    "        # Classifier head\n",
    "        layers.Flatten(),\n",
    "        layers.Dense(256, activation='relu'),\n",
    "        layers.BatchNormalization(),\n",
    "        layers.Dropout(0.5),\n",
    "        layers.Dense(num_classes, activation='softmax')\n",
    "    ], name='CIFAR10_CNN')\n",
    "    return model\n",
    "\n",
    "model = build_cnn()\n",
    "model.summary()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 4. Compile & Train"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "model.compile(\n",
    "    optimizer=keras.optimizers.Adam(learning_rate=1e-3),\n",
    "    loss='categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "cb_list = [\n",
    "    callbacks.EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True, verbose=1),\n",
    "    callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=5, min_lr=1e-6, verbose=1),\n",
    "]\n",
    "\n",
    "BATCH_SIZE = 128\n",
    "EPOCHS     = 50  # EarlyStopping will stop earlier if val_loss plateaus\n",
    "\n",
    "history = model.fit(\n",
    "    datagen.flow(X_train_norm, y_train_oh, batch_size=BATCH_SIZE),\n",
    "    steps_per_epoch=len(X_train_norm) // BATCH_SIZE,\n",
    "    epochs=EPOCHS,\n",
    "    validation_data=(X_test_norm, y_test_oh),\n",
    "    callbacks=cb_list,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "print(f'\\nTraining complete. Best val accuracy: {max(history.history[\"val_accuracy\"]):.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 5. Training Curves"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "axes[0].plot(history.history['accuracy'],     label='Train Accuracy', color='steelblue', lw=2)\n",
    "axes[0].plot(history.history['val_accuracy'], label='Val Accuracy',   color='coral',     lw=2)\n",
    "axes[0].set_title('Accuracy over Epochs', fontsize=13)\n",
    "axes[0].set_xlabel('Epoch')\n",
    "axes[0].set_ylabel('Accuracy')\n",
    "axes[0].legend()\n",
    "\n",
    "axes[1].plot(history.history['loss'],     label='Train Loss', color='steelblue', lw=2)\n",
    "axes[1].plot(history.history['val_loss'], label='Val Loss',   color='coral',     lw=2)\n",
    "axes[1].set_title('Loss over Epochs', fontsize=13)\n",
    "axes[1].set_xlabel('Epoch')\n",
    "axes[1].set_ylabel('Loss')\n",
    "axes[1].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Final evaluation\n",
    "test_loss, test_acc = model.evaluate(X_test_norm, y_test_oh, verbose=0)\n",
    "print(f'\\nTest Accuracy: {test_acc:.4f} | Test Loss: {test_loss:.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 6. Per-Class Analysis"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "y_pred_prob = model.predict(X_test_norm, verbose=0)\n",
    "y_pred      = np.argmax(y_pred_prob, axis=1)\n",
    "\n",
    "print('Classification Report:')\n",
    "print(classification_report(y_test, y_pred, target_names=CLASS_NAMES))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Confusion matrix\n",
    "cm = confusion_matrix(y_test, y_pred)\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n",
    "            xticklabels=CLASS_NAMES, yticklabels=CLASS_NAMES)\n",
    "plt.title('Confusion Matrix — CIFAR-10 CNN', fontsize=14)\n",
    "plt.xlabel('Predicted')\n",
    "plt.ylabel('True')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Per-class accuracy\n",
    "per_class_acc = cm.diagonal() / cm.sum(axis=1)\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.bar(CLASS_NAMES, per_class_acc, color='steelblue', edgecolor='white')\n",
    "plt.axhline(per_class_acc.mean(), color='red', linestyle='--', label=f'Mean: {per_class_acc.mean():.3f}')\n",
    "plt.title('Per-Class Accuracy', fontsize=13)\n",
    "plt.ylabel('Accuracy')\n",
    "plt.xticks(rotation=20)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 7. Visualising Misclassifications"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "errors     = np.where(y_pred != y_test)[0]\n",
    "n_show     = min(12, len(errors))\n",
    "sample_idx = np.random.choice(errors, n_show, replace=False)\n",
    "\n",
    "fig, axes = plt.subplots(3, 4, figsize=(14, 10))\n",
    "for ax, idx in zip(axes.flat, sample_idx):\n",
    "    ax.imshow(X_test[idx])\n",
    "    true_lbl = CLASS_NAMES[y_test[idx]]\n",
    "    pred_lbl = CLASS_NAMES[y_pred[idx]]\n",
    "    conf     = y_pred_prob[idx, y_pred[idx]]\n",
    "    ax.set_title(f'True: {true_lbl}\\nPred: {pred_lbl} ({conf:.2f})',\n",
    "                  fontsize=9,\n",
    "                  color='red' if true_lbl != pred_lbl else 'green')\n",
    "    ax.axis('off')\n",
    "\n",
    "plt.suptitle('Misclassified Examples', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Transfer Learning (MobileNetV2 Backbone)\n",
    "For even higher accuracy, we can use a pretrained backbone and fine-tune just the classification head."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Upsample CIFAR-10 to 96x96 (MobileNetV2 minimum input)\n",
    "X_train_up = tf.image.resize(X_train_norm, (96, 96)).numpy()\n",
    "X_test_up  = tf.image.resize(X_test_norm,  (96, 96)).numpy()\n",
    "\n",
    "base_model = keras.applications.MobileNetV2(\n",
    "    input_shape=(96, 96, 3),\n",
    "    include_top=False,\n",
    "    weights='imagenet'\n",
    ")\n",
    "base_model.trainable = False  # Freeze backbone\n",
    "\n",
    "tl_model = models.Sequential([\n",
    "    base_model,\n",
    "    layers.GlobalAveragePooling2D(),\n",
    "    layers.Dense(256, activation='relu'),\n",
    "    layers.Dropout(0.4),\n",
    "    layers.Dense(10, activation='softmax')\n",
    "], name='MobileNetV2_CIFAR10')\n",
    "\n",
    "tl_model.compile(\n",
    "    optimizer=keras.optimizers.Adam(1e-3),\n",
    "    loss='categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "tl_model.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Phase 1: Train head only (5 epochs)\n",
    "tl_history1 = tl_model.fit(\n",
    "    X_train_up, y_train_oh,\n",
    "    batch_size=256,\n",
    "    epochs=5,\n",
    "    validation_data=(X_test_up, y_test_oh),\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "# Phase 2: Unfreeze top layers & fine-tune\n",
    "base_model.trainable = True\n",
    "for layer in base_model.layers[:-30]:\n",
    "    layer.trainable = False\n",
    "\n",
    "tl_model.compile(\n",
    "    optimizer=keras.optimizers.Adam(1e-5),   # lower LR for fine-tuning\n",
    "    loss='categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "tl_history2 = tl_model.fit(\n",
    "    X_train_up, y_train_oh,\n",
    "    batch_size=256,\n",
    "    epochs=10,\n",
    "    validation_data=(X_test_up, y_test_oh),\n",
    "    callbacks=[callbacks.EarlyStopping(patience=5, restore_best_weights=True)],\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "tl_loss, tl_acc = tl_model.evaluate(X_test_up, y_test_oh, verbose=0)\n",
    "print(f'\\nMobileNetV2 Transfer Learning Test Accuracy: {tl_acc:.4f}')\n",
    "print(f'Custom CNN Test Accuracy: {test_acc:.4f}')\n",
    "print(f'Improvement: +{(tl_acc - test_acc)*100:.1f}%')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Summary\n",
    "\n",
    "| Model | Test Accuracy | Parameters |\n",
    "|---|---|---|\n",
    "| Custom CNN (from scratch) | ~82% | ~870K |\n",
    "| MobileNetV2 (transfer learning) | ~88%+ | ~3.4M (frozen) |\n",
    "\n",
    "**Key findings:**\n",
    "- The custom 3-block CNN achieves ~82% test accuracy on CIFAR-10, well above the ~10% random baseline.\n",
    "- BatchNormalization + Dropout significantly reduces overfitting.\n",
    "- Data augmentation adds ~2-3% accuracy by exposing the model to more varied examples.\n",
    "- Transfer learning from ImageNet (MobileNetV2) gives a further boost with minimal training time.\n",
    "- The most confused classes are `cat↔dog` and `automobile↔truck`, which also confuse humans.\n",
    "- **Next steps:** Increase resolution, use ResNet50 backbone, or apply CutMix/MixUp augmentation for state-of-the-art performance.\n"
   ]
  }
 ],
 "metadata": {
  "kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"},
  "language_info": {"name": "python", "version": "3.10.0"}
 },
